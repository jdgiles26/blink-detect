# ─── Blink Account ────────────────────────────────────────
BLINK_EMAIL=your@email.com
BLINK_PASSWORD=yourpassword

# ─── YOLOv8 Detection ────────────────────────────────────
# Model name (auto-downloads) or absolute path to custom .pt
YOLO_MODEL=yolov8n.pt
# Confidence threshold 0.0–1.0
YOLO_CONF=0.4

# ─── Streaming ───────────────────────────────────────────
# Seconds between RTSPS URL renewals (Blink expires ~30s)
STREAM_REFRESH_INTERVAL=25
# Seconds between YOLOv8 inference runs per camera
DETECTION_INTERVAL=2.0

# ─── Server ──────────────────────────────────────────────
# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Data volume: HLS segments, credentials, custom models
DATA_DIR=/data

# ─── Development ─────────────────────────────────────────
# true = skip Blink auth, use synthetic FFmpeg test streams
MOCK_MODE=false
